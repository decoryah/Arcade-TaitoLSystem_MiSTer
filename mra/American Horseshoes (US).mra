<misterromdescription>
    <rotation>vertical</rotation>
    <name>American Horseshoes (US)</name>
    <setname>horshoes</setname>
    <mameversion>0289</mameversion>
    <year>1990</year>
    <manufacturer>Taito America</manufacturer>
    <players>2</players>
    <joystick>8</joystick>
    <rbf>taitol</rbf>
    <platform>Taito L</platform>

    <!--
      Flat image for the Taito L core (target/mister/taitol_mem.sv), the same for every set (tools/taitol_rom.py):
        0x000000  0x100000  maincpu
        0x100000  0x180000  maincpu:gfx
        0x280000  0x080000  audiocpu
        0x300000  0x020000  slave
        0x320000  0x080000  adpcm
        0x3A0000  0x000800  mcu:mcu
        0x3A0800  0x000030  configuration: [0] board [1:2] 8x8 tiles [3:5] tile mask [6:8] program ROM mask [9] rotation [10] flags [16:42] controls

      Expects the MAME 0.289 merged romset or the split sets: parts are found by name and CRC.
      DIP switches (ioctl index 254): byte 0 is MAME's DSWA, byte 1 DSWB (a 1 is MAME's default setting).
    -->
    <switches default="FF,FF" base="16">
        <dip bits="0" name="Beer Frame Message" ids="Beer Frame,Break Time"/>
        <dip bits="1" name="Flip Screen" ids="On,Off"/>
        <dip bits="2" name="Service Mode" ids="On,Off"/>
        <dip bits="3" name="Demo Sounds" ids="Off,On"/>
        <dip bits="4,5" name="Coinage" ids="4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/1 Credit"/>
        <dip bits="6,7" name="Price to Continue" ids="3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/1 Credit,Same as Start"/>
        <dip bits="8,9" name="Difficulty" ids="Hardest,Hard,Easy,Medium"/>
        <dip bits="10,11" name="Time" ids="60 sec,40 sec,20 sec,30 sec"/>
        <dip bits="12" name="Innings" ids="9 per Credit,3 per Credit"/>
        <dip bits="13" name="Bonus Advantage" ids="On,Off"/>
        <dip bits="14" name="Scoring Speed" ids="Fast,Normal"/>
        <dip bits="15" name="Grip/Angle Select" ids="1 Button,2 Buttons"/>
    </switches>

    <buttons names="Button 1,Button 2,Start,Coin" default="A,B,Start,Select"/>

    <rom index="0" zip="horshoes.zip" md5="None">

        <!-- maincpu -->
        <part name="c47-03.ic6" crc="37e15b20"/>
        <part repeat="0xE0000">00</part>

        <!-- maincpu:gfx -->
        <interleave output="16">
            <part name="c47-02.ic5" crc="35f96526" offset="0x0" length="0x10000" map="01"/>
            <part name="c47-04.ic4" crc="aeac7121" offset="0x0" length="0x10000" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="c47-01.ic11" crc="031c73d8" offset="0x0" length="0x10000" map="01"/>
            <part name="c47-05.ic10" crc="b2a3dafe" offset="0x0" length="0x10000" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="c47-02.ic5" crc="35f96526" offset="0x10000" length="0x10000" map="01"/>
            <part name="c47-04.ic4" crc="aeac7121" offset="0x10000" length="0x10000" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="c47-01.ic11" crc="031c73d8" offset="0x10000" length="0x10000" map="01"/>
            <part name="c47-05.ic10" crc="b2a3dafe" offset="0x10000" length="0x10000" map="10"/>
        </interleave>
        <part repeat="0x100000">00</part>

        <!-- audiocpu -->
        <part repeat="0x80000">00</part>

        <!-- slave -->
        <part repeat="0x20000">00</part>

        <!-- adpcm -->
        <part repeat="0x80000">00</part>

        <!-- mcu:mcu -->
        <part repeat="0x800">00</part>

        <!-- configuration -->
        <part>04 00 40 FF 3F 00 FF FF 01 03 00 00 00 00 00 00 13 0F 00 00 00 00 00 05 14 10 00 00 00 00 00 06 00 00 00 00 00 00 00 00 FF FF FF 00 00 00 00 00</part>
    </rom>
</misterromdescription>
