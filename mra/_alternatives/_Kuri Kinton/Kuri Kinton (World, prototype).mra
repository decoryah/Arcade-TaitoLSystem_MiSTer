<misterromdescription>
    <rotation>horizontal</rotation>
    <name>Kuri Kinton (World, prototype)</name>
    <setname>kurikinta</setname>
    <mameversion>0289</mameversion>
    <year>1988</year>
    <manufacturer>Taito</manufacturer>
    <players>2</players>
    <joystick>8</joystick>
    <rbf>taitol</rbf>
    <platform>Taito L</platform>

    <!--
      Flat image for the Taito L core (target/mister/taitol_mem.sv), the same for every set (tools/taitol_rom.py):
        0x000000  0x100000  maincpu
        0x100000  0x180000  maincpu:gfx
        0x280000  0x080000  audiocpu
        0x300000  0x020000  slave
        0x320000  0x080000  adpcm
        0x3A0000  0x000800  mcu:mcu
        0x3A0800  0x000030  configuration: [0] board [1:2] 8x8 tiles [3:5] tile mask [6:8] program ROM mask [9] rotation [10] flags [16:42] controls

      Expects the MAME 0.289 merged romset or the split sets: parts are found by name and CRC.
      DIP switches (ioctl index 254): byte 0 is MAME's DSWA, byte 1 DSWB (a 1 is MAME's default setting).
    -->
    <switches default="FC,FF" base="16">
        <dip bits="0" name="Cabinet" ids="Upright,Cocktail"/>
        <dip bits="1" name="Flip Screen" ids="Off,On"/>
        <dip bits="2" name="Unknown" ids="On,Off"/>
        <dip bits="3" name="Unknown" ids="On,Off"/>
        <dip bits="4,5" name="Coin A" ids="4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/1 Credit"/>
        <dip bits="6,7" name="Coin B" ids="1 Coin/6 Credits,1 Coin/4 Credits,1 Coin/3 Credits,1 Coin/2 Credits"/>
        <dip bits="8" name="Level Select (Cheat)" ids="On,Off"/>
        <dip bits="9" name="Invulnerability (Cheat)" ids="On,Off"/>
        <dip bits="10,11" name="Difficulty" ids="Hardest,Hard,Easy,Medium"/>
        <dip bits="12" name="Unknown" ids="On,Off"/>
        <dip bits="13" name="Bosses' messages" ids="Off,On"/>
        <dip bits="14" name="Unknown" ids="On,Off"/>
        <dip bits="15" name="Slow Motion (Cheat)" ids="On,Off"/>
    </switches>

    <buttons names="Button 1,Button 2,Start,Coin" default="A,B,Start,Select"/>

    <rom index="0" zip="kurikinta.zip|kurikint.zip" md5="None">

        <!-- maincpu -->
        <part name="kk_ic2.ic2" crc="908603f2"/>
        <part name="kk_ic6.ic6" crc="a4a957b1"/>
        <part repeat="0xC0000">00</part>

        <!-- maincpu:gfx -->
        <interleave output="16">
            <part name="kk_1-1l.rom" crc="df1d4fcd" map="01"/>
            <part name="kk_3-1h.rom" crc="71af848e" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="kk_2-2l.rom" crc="fca7f647" map="01"/>
            <part name="kk_4-2h.rom" crc="cebb5bac" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="kk_5-3l.rom" crc="d080fde1" map="01"/>
            <part name="kk_6-3h.rom" crc="322e3752" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="kk_7-4l.rom" crc="f5bf6829" map="01"/>
            <part name="kk_8-4h.rom" crc="117bde99" map="10"/>
        </interleave>
        <part repeat="0x80000">00</part>

        <!-- audiocpu -->
        <part name="b42-07.ic22" crc="0f2719c0"/>
        <part repeat="0x70000">00</part>

        <!-- slave -->
        <part repeat="0x20000">00</part>

        <!-- adpcm -->
        <part repeat="0x80000">00</part>

        <!-- mcu:mcu -->
        <part repeat="0x800">00</part>

        <!-- configuration -->
        <part>05 00 80 FF 7F 00 FF FF 03 00 00 00 00 00 00 00 01 02 03 04 05 06 00 00 08 09 0A 0B 0C 0D 00 00 14 13 0F 10 00 00 11 12 FF FF F3 00 00 00 00 00</part>
    </rom>
</misterromdescription>
