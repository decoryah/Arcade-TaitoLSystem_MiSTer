<misterromdescription>
    <rotation>horizontal</rotation>
    <name>Puzznic (bootleg, set 1)</name>
    <setname>puzznicb</setname>
    <mameversion>0289</mameversion>
    <year>1989</year>
    <manufacturer>bootleg</manufacturer>
    <players>2</players>
    <joystick>8</joystick>
    <rbf>taitol</rbf>
    <platform>Taito L</platform>

    <!--
      Flat image for the Taito L core (target/mister/taitol_mem.sv), the same for every set (tools/taitol_rom.py):
        0x000000  0x100000  maincpu
        0x100000  0x180000  maincpu:gfx
        0x280000  0x080000  audiocpu
        0x300000  0x020000  slave
        0x320000  0x080000  adpcm
        0x3A0000  0x000800  mcu:mcu
        0x3A0800  0x000030  configuration: [0] board [1:2] 8x8 tiles [3:5] tile mask [6:8] program ROM mask [9] rotation [10] flags [16:42] controls

      Expects the MAME 0.289 merged romset or the split sets: parts are found by name and CRC.
      DIP switches (ioctl index 254): byte 0 is MAME's DSWA, byte 1 DSWB (a 1 is MAME's default setting).
    -->
    <switches default="FE,FF" base="16">
        <dip bits="0" name="Cabinet" ids="Upright,Cocktail"/>
        <dip bits="1" name="Flip Screen" ids="On,Off"/>
        <dip bits="2" name="Service Mode" ids="On,Off"/>
        <dip bits="3" name="Demo Sounds" ids="Off,On"/>
        <dip bits="4,5" name="Coinage" ids="2 Coins/3 Credits,2 Coins/1 Credit,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip bits="6" name="Unused" ids="On,Off"/>
        <dip bits="7" name="Unused" ids="On,Off"/>
        <dip bits="8,9" name="Difficulty" ids="Hardest,Hard,Easy,Medium"/>
        <dip bits="10,11" name="Retries" ids="0,1,3,2"/>
        <dip bits="12" name="Bombs" ids="2,0"/>
        <dip bits="13" name="Girls" ids="No,Yes"/>
        <dip bits="14,15" name="Terms of Replay" ids="No Use,Stage one step back/Timer continuous,Stage reset to start/Timer reset to start,Stage reset to start/Timer continuous"/>
    </switches>

    <buttons names="Button 1,Button 2,Start,Coin" default="A,B,Start,Select"/>

    <rom index="0" zip="puzznicb.zip|puzznic.zip" md5="None">

        <!-- maincpu -->
        <part name="ic11.bin" crc="2510df4d"/>
        <part repeat="0xE0000">00</part>

        <!-- maincpu:gfx -->
        <interleave output="16">
            <part name="ic10.bin" crc="be12749a" map="01"/>
            <part name="ic9.bin" crc="0f183340" map="10"/>
        </interleave>
        <part repeat="0x160000">00</part>

        <!-- audiocpu -->
        <part repeat="0x80000">00</part>

        <!-- slave -->
        <part repeat="0x20000">00</part>

        <!-- adpcm -->
        <part repeat="0x80000">00</part>

        <!-- mcu:mcu -->
        <part repeat="0x800">00</part>

        <!-- configuration -->
        <part>02 00 10 FF 0F 00 FF FF 01 00 00 00 00 00 00 00 13 0F 11 01 02 03 04 05 06 0D 12 08 09 0A 0B 0C 00 00 00 00 00 00 00 00 FF FF FF 00 00 00 00 00</part>
    </rom>
</misterromdescription>
