<misterromdescription>
    <rotation>vertical</rotation>
    <name>Play Girls 2 (Japan)</name>
    <setname>plgirls2j</setname>
    <mameversion>0289</mameversion>
    <year>1993</year>
    <manufacturer>Hot-B</manufacturer>
    <players>2</players>
    <joystick>8</joystick>
    <rbf>taitol</rbf>
    <platform>Taito L</platform>

    <!--
      Flat image for the Taito L core (target/mister/taitol_mem.sv), the same for every set (tools/taitol_rom.py):
        0x000000  0x100000  maincpu
        0x100000  0x180000  maincpu:gfx
        0x280000  0x080000  audiocpu
        0x300000  0x020000  slave
        0x320000  0x080000  adpcm
        0x3A0000  0x000800  mcu:mcu
        0x3A0800  0x000030  configuration: [0] board [1:2] 8x8 tiles [3:5] tile mask [6:8] program ROM mask [9] rotation [10] flags [16:42] controls

      Expects the MAME 0.289 merged romset or the split sets: parts are found by name and CRC.
      DIP switches (ioctl index 254): byte 0 is MAME's DSWA, byte 1 DSWB (a 1 is MAME's default setting).
    -->
    <switches default="FF,FF" base="16">
        <dip bits="0" name="Unused" ids="On,Off"/>
        <dip bits="1" name="Flip Screen" ids="On,Off"/>
        <dip bits="2" name="Service Mode" ids="On,Off"/>
        <dip bits="3" name="Coin Mode" ids="Mode B,Mode A"/>
        <dip bits="4,5" name="Coin A" ids="2 Coins/3 Credits,2 Coins/1 Credit,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip bits="6,7" name="Coin B" ids="2 Coins/3 Credits,2 Coins/1 Credit,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip bits="8,9" name="Difficulty" ids="Hardest,Hard,Easy,Medium"/>
        <dip bits="10" name="Time" ids="3 Seconds,2 Seconds"/>
        <dip bits="11,12" name="Lives for Joe/Lady/Jack" ids="6/5/6,5/4/5,3/2/3,4/3/4"/>
        <dip bits="13" name="Character Speed" ids="Fast,Normal"/>
        <dip bits="14" name="Unused" ids="On,Off"/>
        <dip bits="15" name="Unused" ids="On,Off"/>
    </switches>

    <buttons names="Button 1,Button 2,Start,Coin" default="A,B,Start,Select"/>

    <rom index="0" zip="plgirls2j.zip|plgirls2.zip" md5="None">

        <!-- maincpu -->
        <part name="pg2_1j.ic6" crc="f924197a"/>
        <part repeat="0xC0000">00</part>

        <!-- maincpu:gfx -->
        <interleave output="16">
            <part name="cho-l.ic9" crc="956384ec" map="01"/>
            <part name="cho-h.ic7" crc="992f99b1" map="10"/>
        </interleave>
        <part repeat="0x80000">00</part>

        <!-- audiocpu -->
        <part repeat="0x80000">00</part>

        <!-- slave -->
        <part repeat="0x20000">00</part>

        <!-- adpcm -->
        <part repeat="0x80000">00</part>

        <!-- mcu:mcu -->
        <part repeat="0x800">00</part>

        <!-- configuration -->
        <part>03 00 80 FF 7F 00 FF FF 03 03 00 00 00 00 00 00 13 14 0F 10 11 12 05 06 01 02 03 04 08 09 0A 0B 0C 0D 00 00 00 00 00 00 FF FF FF 00 00 00 00 00</part>
    </rom>
</misterromdescription>
