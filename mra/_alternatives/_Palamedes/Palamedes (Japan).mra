<misterromdescription>
    <rotation>horizontal</rotation>
    <name>Palamedes (Japan)</name>
    <setname>palamedj</setname>
    <mameversion>0289</mameversion>
    <year>1990</year>
    <manufacturer>Taito</manufacturer>
    <players>2</players>
    <joystick>8</joystick>
    <rbf>taitol</rbf>
    <platform>Taito L</platform>

    <!--
      Flat image for the Taito L core (target/mister/taitol_mem.sv), the same for every set (tools/taitol_rom.py):
        0x000000  0x100000  maincpu
        0x100000  0x180000  maincpu:gfx
        0x280000  0x080000  audiocpu
        0x300000  0x020000  slave
        0x320000  0x080000  adpcm
        0x3A0000  0x000800  mcu:mcu
        0x3A0800  0x000030  configuration: [0] board [1:2] 8x8 tiles [3:5] tile mask [6:8] program ROM mask [9] rotation [10] flags [16:42] controls

      Expects the MAME 0.289 merged romset or the split sets: parts are found by name and CRC.
      DIP switches (ioctl index 254): byte 0 is MAME's DSWA, byte 1 DSWB (a 1 is MAME's default setting).
    -->
    <switches default="FF,FF" base="16">
        <dip bits="0" name="Unused" ids="On,Off"/>
        <dip bits="1" name="Flip Screen" ids="On,Off"/>
        <dip bits="2" name="Service Mode" ids="On,Off"/>
        <dip bits="3" name="Demo Sounds" ids="Off,On"/>
        <dip bits="4,5" name="Coin A" ids="3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip bits="6,7" name="Coin B" ids="3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip bits="8,9" name="Difficulty" ids="Hardest,Hard,Easy,Medium"/>
        <dip bits="10,11" name="Games for VS Victory" ids="4 Games,3 Games,1 Game,2 Games"/>
        <dip bits="12,13" name="Dice Appear at" ids="3000 Lines,2000 Lines,500 Lines,1000 Lines"/>
        <dip bits="14" name="Unused" ids="On,Off"/>
        <dip bits="15" name="Versus Mode" ids="No,Yes"/>
    </switches>

    <buttons names="Button 1,Button 2,Start,Coin" default="A,B,Start,Select"/>

    <rom index="0" zip="palamedj.zip|palamed.zip" md5="None">

        <!-- maincpu -->
        <part name="c63-02.ic6" crc="55a82bb2"/>
        <part repeat="0xE0000">00</part>

        <!-- maincpu:gfx -->
        <interleave output="16">
            <part name="c63-04.ic9" crc="c7bbe460" map="01"/>
            <part name="c63-03.ic7" crc="fcd86e44" map="10"/>
        </interleave>
        <part repeat="0x140000">00</part>

        <!-- audiocpu -->
        <part repeat="0x80000">00</part>

        <!-- slave -->
        <part repeat="0x20000">00</part>

        <!-- adpcm -->
        <part repeat="0x80000">00</part>

        <!-- mcu:mcu -->
        <part repeat="0x800">00</part>

        <!-- configuration -->
        <part>03 00 20 FF 1F 00 FF FF 01 00 00 00 00 00 00 00 13 14 0F 10 11 12 05 06 01 02 03 04 08 09 0A 0B 0C 0D 00 00 00 00 00 00 FF FF FF 00 00 00 00 00</part>
    </rom>
</misterromdescription>
