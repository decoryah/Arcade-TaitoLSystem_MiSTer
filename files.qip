# MiSTer platform layer
set_global_assignment -name SYSTEMVERILOG_FILE target/mister/taitol_mem.sv
set_global_assignment -name SYSTEMVERILOG_FILE target/mister/sdram_ctrl.sv

# jt12 / jt03, YM2203 (GPL-3, Jose Tejada)
set_global_assignment -name QIP_FILE modules/jt12/jt03.qip

# jt49, the YM2203's SSG (GPL-3, Jose Tejada)
set_global_assignment -name VERILOG_FILE modules/jt49/jt49.v
