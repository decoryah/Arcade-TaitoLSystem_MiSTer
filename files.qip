# jt6805, the MC6805 core of Puzznic's MC68705 (GPL-3, Jose Tejada); 6805.vh / 6805_param.vh are generated, see modules/jt680x/UPSTREAM.txt
set_global_assignment -name SYSTEMVERILOG_FILE rtl/taitol_mcu.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/taitol_i8255.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/taitol_upd4701.sv
set_global_assignment -name VERILOG_FILE modules/jt680x/jt6805.v
set_global_assignment -name VERILOG_FILE modules/jt680x/jt6805_alu.v
set_global_assignment -name VERILOG_FILE modules/jt680x/jt6805_ctrl.v
set_global_assignment -name VERILOG_FILE modules/jt680x/jt6805_regs.v

# jt5205, the MSM5205 of Champion Wrestler (GPL-3, Jose Tejada)
set_global_assignment -name VERILOG_FILE modules/jt5205/jt5205.v
set_global_assignment -name VERILOG_FILE modules/jt5205/jt5205_adpcm.v
set_global_assignment -name VERILOG_FILE modules/jt5205/jt5205_timing.v
set_global_assignment -name VERILOG_FILE modules/jt5205/jt5205_interpol2x.v

# CRT Adjust (H-Size / H-Position / V-Shift for 15 kHz CRTs): rmonic79's module unmodified (GPL-3.0-or-later, modules/crt_adjust) and the core's glue
set_global_assignment -name SYSTEMVERILOG_FILE modules/crt_adjust/crt_adjust.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/taitol_crt_adjust.sv
